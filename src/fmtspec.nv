// fmtspec.nv — what a format string turns into: a list of literals and
// parameters, each parameter carrying a type and a way to display it.
//
// THE GRAMMAR, IN ONE PLACE
//
// A deferred-format string is ordinary text with `{…}` holes in it, and
// a hole says up to three things:
//
//     {}              an argument, index implied by position
//     {0}             argument 0, by index
//     {=u8}           an argument whose WIRE TYPE is one byte
//     {0=u8}          both
//     {=u8:x}         and displayed as hexadecimal
//     {0=0..4}        bits 0 through 3 of argument 0
//     {{  }}          a literal brace
//
// The type hint is the load-bearing half and it is why this package
// exists.  The device sends RAW BYTES with no tags in them: four bytes
// for a `u32`, one for a `u8`, a varint for a `usize`.  Nothing on the
// wire says which.  The only thing that can tell the decoder how many
// bytes to take and how to read them is the type hint in the format
// string, which lives in the ELF.  So the format string is not
// decoration — it is the schema, and parsing it is a prerequisite to
// reading a single argument byte.
//
// WHY TYPE AND DISPLAY ARE TWO THINGS
//
// `{=u8:x}` has both.  `=u8` says one byte comes off the wire; `:x`
// says render it as hex.  Getting the first wrong desynchronises the
// stream and every line after it is garbage; getting the second wrong
// prints a decimal number where a person wanted hex.  Different
// severities, so different types, and `DeflogParam` carries them
// separately.
//
// WHY THE INDEX IS ALWAYS RESOLVED
//
// `{}` `{}` `{}` and `{0}` `{1}` `{2}` describe the same three
// arguments, and mixing the two forms in one string is refused.  Every
// `DeflogParam` that comes out of a parse has a RESOLVED index, so a
// decoder never has to keep a positional counter of its own — and a
// format string that mentions argument 0 twice, once as `{=u8}` and
// once as `{0:x}`, has one argument on the wire and two places it is
// printed, which only works if the index is resolved.

// DeflogArgType is the wire type of one argument: how many bytes it
// occupies and how they are read.
//
// This is `defmt`'s type list, spelled with an `Arg` prefix because
// `U8` and `Str` and `Debug` as bare variant names would collide with
// half the registry.  A type NOT in this list is a refusal at parse
// time rather than a guess at decode time, because a guess
// desynchronises the whole stream.
pub enum DeflogArgType
    // `{}` with no type hint at all.  Legal, and it means the argument
    // was interned with its own type — a `{=?}` in disguise — rather
    // than that the type is unknown.
    ArgUnspecified
    // `{=bool}`: one byte, and in a run of consecutive bools, one BIT
    // of a shared byte.  The one type whose encoding depends on its
    // neighbours, which is why a decoder cannot read arguments
    // independently of each other.
    ArgBool
    // `{=u8}`, `{=u16}`, `{=u24}`, `{=u32}`, `{=u64}`, `{=u128}`:
    // that many bits, little-endian, unsigned.  `u24` is three bytes
    // and exists because a great many device registers are three bytes.
    ArgU8
    ArgU16
    ArgU24
    ArgU32
    ArgU64
    ArgU128
    // `{=usize}`: a LEB128 varint, because a pointer-sized value on a
    // 32-bit target is usually small and a varint makes it one byte.
    ArgUsize
    // `{=i8}` … `{=i128}`: that many bits, little-endian, two's
    // complement.
    ArgI8
    ArgI16
    ArgI32
    ArgI64
    ArgI128
    // `{=isize}`: zigzag-folded and then LEB128, so that -1 is one byte
    // rather than ten.
    ArgIsize
    // `{=f32}`, `{=f64}`: IEEE 754, little-endian.
    ArgF32
    ArgF64
    // `{=str}`: a LEB128 length and then that many UTF-8 bytes.  The
    // string is ON THE WIRE, which is the expensive case and the reason
    // `ArgIStr` exists.
    ArgStr
    // `{=istr}`: an INTERNED string — a LEB128 index into the same
    // table the format strings live in.  A string constant costs the
    // device one varint instead of its own length.
    ArgIStr
    // `{=char}`: a `u32` scalar value.
    ArgChar
    // `{=?}`: a nested formatted value.  A type index and then that
    // type's own arguments, recursively — which is how a user type
    // reaches the host without the device carrying a formatter.
    ArgFormat
    // `{=[?]}`: a length-prefixed sequence of `ArgFormat`, all of one
    // type, with the type index sent once.
    ArgFormatSlice
    // `{=[?; N]}`: exactly `len` nested values, with no length on the
    // wire because the format string already said how many.
    ArgFormatArray(len: Int)
    // A sequence of nested values written one after another by an
    // iterator, terminated rather than counted.
    ArgFormatSequence
    // `{=[u8]}`: a LEB128 length and then that many raw bytes.
    ArgU8Slice
    // `{=[u8; N]}`: exactly `len` raw bytes, no length on the wire.
    ArgU8Array(len: Int)
    // `{=?}` rendered through the value's own debug walk.  Distinct
    // from `ArgFormat` only in how it is displayed.
    ArgDebug
    // A value rendered through its display walk.
    ArgDisplay
    // `{0=0..4}`: bits `start` up to but not including `end` of the
    // argument at that index.  NO BYTES OF ITS OWN — the argument is
    // sent once at its own type and several bitfield parameters read
    // different bits of it, which is the whole point.  `end` is
    // exclusive and at most 128.
    ArgBitField(start: Int, end: Int)

// DeflogPrecision is how much of a duration a time hint renders.
pub enum DeflogPrecision
    PrecSeconds
    PrecMilliseconds
    PrecMicroseconds
    PrecNanoseconds

// DeflogHint is how a parameter is DISPLAYED, once its bytes have been
// read.
//
// Never affects how many bytes come off the wire — that is
// `DeflogArgType`'s job, and the separation is deliberate.  A hint this
// package does not know is `HintUnknown` rather than a refusal, because
// a firmware built with a newer encoder should still decode its numbers
// correctly on an older host; the hint is the only part it is safe to
// be forgiving about.
pub enum DeflogHint
    // No `:` hint, or a bare `:` with only a zero-pad width.
    // `zero_pad` is 0 when there was none.
    HintNone(zero_pad: Int)
    // `:b` — binary.  `alternate` is `:#b`, which prefixes `0b`.
    HintBinary(alternate: Bool, zero_pad: Int)
    // `:x` and `:X` — hexadecimal.  `alternate` is `:#x` (`0x`),
    // `uppercase` is `:X`.
    HintHex(alternate: Bool, uppercase: Bool, zero_pad: Int)
    // `:o` — octal.
    HintOctal(alternate: Bool, zero_pad: Int)
    // `:a` — bytes as ASCII, with the unprintable ones escaped.
    HintAscii
    // `:?` — the value's debug rendering.
    HintDebug
    // `:?` applied to each element of a sequence.
    HintSeqDebug
    // `:us`, `:ms`, `:s` — an integer read as a duration and printed
    // with its unit.
    HintMicroseconds
    HintMilliseconds
    HintSeconds
    // `:iso8601ms` and its siblings — an integer read as a time and
    // printed as a timestamp.
    HintIso8601(precision: DeflogPrecision)
    // `:__internal_bitflags_…` — a bit set rendered as the names of the
    // flags that are set.  The three parts identify which bitflags
    // declaration to look up in the symbol table; `package` is the
    // crate or package the declaration came from and
    // `disambiguator` separates two declarations of the same name.
    HintBitflags(name: Str, package: Str, disambiguator: Str)
    // A `:` hint this package has no grammar for, kept verbatim.
    // NOT a refusal: see the type note.
    HintUnknown(text: Str)

// DeflogParam is one `{…}` hole: which argument, what type, how shown.
pub struct DeflogParam
    // Resolved.  Always, whether the string wrote `{}` or `{3}`.
    index: Int
    kind: DeflogArgType
    // `None` when the hole had no `:` part.
    hint: ?DeflogHint
    // Byte offset of the opening `{` in the format string, so that a
    // later refusal — an argument count that does not match, a type the
    // decoder cannot read — can point at the hole that asked for it.
    at: Int

// DeflogFragment is one piece of a parsed format string.
//
// A format string is a list of these, in order, and rendering it is
// walking the list: print the literals, and print the arguments the
// parameters name.  `defmt-parser` upstream calls it `Fragment` and it
// is the same shape.
pub enum DeflogFragment
    // Text to print as it stands, with `{{` and `}}` already unescaped
    // to single braces.
    FragLiteral(text: Str)
    // A hole.
    FragParam(param: DeflogParam)

// DeflogMode is how strict the parse is about hints it does not
// recognise.
pub enum DeflogMode
    // Refuse an unknown type hint AND an unknown display hint.  What a
    // compiler wants: a typo in a format string should be a build
    // error at the call site, not a surprise on a wire six months
    // later.
    ModeStrict
    // Refuse an unknown TYPE hint and keep an unknown display hint as
    // `HintUnknown`.  What a decoder wants: a firmware built with a
    // newer encoder should still have its numbers read correctly by an
    // older host, and a display hint is the only part where being
    // forgiving cannot desynchronise the stream.
    ModeForwardCompatible

// array_token writes the token of the two array shapes, the only types
// whose spelling carries a length: `[u8; 3]` and `[?; 3]`.
fn array_token(head: Str, len: Int) -> Str
    system
        return head + str.from_int(len) + "]"

// bitfield_token writes `0..4`, the only token built from two numbers.
fn bitfield_token(start: Int, end: Int) -> Str
    system
        return str.from_int(start) + ".." + str.from_int(end)

// type_token is the type as it is written inside the braces — `"u8"`,
// `"[u8]"`, `"?"`, `"0..4"` for a bitfield — without the `=`.
//
// The inverse of `type_of_token` for every arm, which is a property the
// test suite asserts: a grammar whose printer and parser disagree is a
// grammar with two definitions.
pub fn type_token(t: DeflogArgType) -> Str
    match t
        ArgUnspecified          => ""
        ArgBool                 => "bool"
        ArgU8                   => "u8"
        ArgU16                  => "u16"
        ArgU24                  => "u24"
        ArgU32                  => "u32"
        ArgU64                  => "u64"
        ArgU128                 => "u128"
        ArgUsize                => "usize"
        ArgI8                   => "i8"
        ArgI16                  => "i16"
        ArgI32                  => "i32"
        ArgI64                  => "i64"
        ArgI128                 => "i128"
        ArgIsize                => "isize"
        ArgF32                  => "f32"
        ArgF64                  => "f64"
        ArgStr                  => "str"
        ArgIStr                 => "istr"
        ArgChar                 => "char"
        ArgFormat               => "?"
        ArgFormatSlice          => "[?]"
        ArgFormatArray(len)     => array_token("[?; ", len)
        ArgFormatSequence       => "__internal_FormatSequence"
        ArgU8Slice              => "[u8]"
        ArgU8Array(len)         => array_token("[u8; ", len)
        ArgDebug                => "__internal_Debug"
        ArgDisplay              => "__internal_Display"
        ArgBitField(start, end) => bitfield_token(start, end)

// slice_eq compares a byte range of a string with a literal, so a token
// can be recognised where it lies instead of being split into pieces
// first.  A device has no substring operation to split with.
fn slice_eq(s: Str, lo: Int, hi: Int, lit: Str) -> Bool
    if hi - lo != str.len(lit)
        return false
    var same = true
    for i in 0..str.len(lit)
        if str.byte_at_or(s, lo + i, 0) != str.byte_at_or(lit, i, 0)
            same = false
    same

// is_digit says whether a byte is one of the ten that spell a number.
fn is_digit(b: Int) -> Bool
    b >= 48 and b <= 57

// span_is_digits says whether every byte of a range is a digit, which
// is what separates `0..4` from a range-shaped piece of junk.
fn span_is_digits(s: Str, lo: Int, hi: Int) -> Bool
    if hi <= lo
        return false
    var ok = true
    for i in lo..hi
        if not is_digit(str.byte_at_or(s, i, 0))
            ok = false
    ok

// digit_end is the index just past the run of digits starting at `lo`,
// or `lo` itself when the byte there is not a digit.
fn digit_end(s: Str, lo: Int) -> Int
    var out = lo
    for i in lo..str.len(s)
        if out == i and is_digit(str.byte_at_or(s, i, 0))
            out = i + 1
    out

// digits_to_int is the number a range of digits spells.  The caller has
// already checked the range holds nothing else.
fn digits_to_int(s: Str, lo: Int, hi: Int) -> Int
    var value = 0
    for i in lo..hi
        value = value * 10 + (str.byte_at_or(s, i, 0) - 48)
    value

// find_text is the index of the first occurrence of a literal inside a
// string, or `-1` when there is none.  `..` is the only text a type
// token is searched for.
fn find_text(s: Str, needle: Str) -> Int
    let n = str.len(s)
    let m = str.len(needle)
    var found = -1
    for i in 0..n
        if found < 0 and i + m <= n and slice_eq(s, i, i + m, needle)
            found = i
    found

// array_length reads the `N` of `[u8; N]` or `[?; N]`.  The spaces
// before the number are optional, which is upstream's grammar.
fn array_length(token: Str, head: Str) -> ?Int
    let n = str.len(token)
    let m = str.len(head)
    if n <= m or not slice_eq(token, 0, m, head)
        return None
    var i = m
    for k in m..n
        if i == k and str.byte_at_or(token, k, 0) == 32
            i = k + 1
    let d = digit_end(token, i)
    if d == i or not slice_eq(token, d, n, "]")
        return None
    Some(digits_to_int(token, i, d))

// type_of_token is the type a hint spells, or `None`.
//
// ```novo
// use fmtspec
//
// fn main() [io]
//     match fmtspec.type_of_token("u24")
//         Some(t) => println(fmtspec.type_token(t))
//         None    => println("no such type")
// ```
pub fn type_of_token(token: Str) -> ?DeflogArgType
    let n = str.len(token)
    if n == 0
        return Some(ArgUnspecified)
    if slice_eq(token, 0, n, "bool")
        return Some(ArgBool)
    if slice_eq(token, 0, n, "u8")
        return Some(ArgU8)
    if slice_eq(token, 0, n, "u16")
        return Some(ArgU16)
    if slice_eq(token, 0, n, "u24")
        return Some(ArgU24)
    if slice_eq(token, 0, n, "u32")
        return Some(ArgU32)
    if slice_eq(token, 0, n, "u64")
        return Some(ArgU64)
    if slice_eq(token, 0, n, "u128")
        return Some(ArgU128)
    if slice_eq(token, 0, n, "usize")
        return Some(ArgUsize)
    if slice_eq(token, 0, n, "i8")
        return Some(ArgI8)
    if slice_eq(token, 0, n, "i16")
        return Some(ArgI16)
    if slice_eq(token, 0, n, "i32")
        return Some(ArgI32)
    if slice_eq(token, 0, n, "i64")
        return Some(ArgI64)
    if slice_eq(token, 0, n, "i128")
        return Some(ArgI128)
    if slice_eq(token, 0, n, "isize")
        return Some(ArgIsize)
    if slice_eq(token, 0, n, "f32")
        return Some(ArgF32)
    if slice_eq(token, 0, n, "f64")
        return Some(ArgF64)
    if slice_eq(token, 0, n, "str")
        return Some(ArgStr)
    if slice_eq(token, 0, n, "istr")
        return Some(ArgIStr)
    if slice_eq(token, 0, n, "char")
        return Some(ArgChar)
    if slice_eq(token, 0, n, "?")
        return Some(ArgFormat)
    if slice_eq(token, 0, n, "[?]")
        return Some(ArgFormatSlice)
    if slice_eq(token, 0, n, "__internal_FormatSequence")
        return Some(ArgFormatSequence)
    if slice_eq(token, 0, n, "[u8]")
        return Some(ArgU8Slice)
    if slice_eq(token, 0, n, "__internal_Debug")
        return Some(ArgDebug)
    if slice_eq(token, 0, n, "__internal_Display")
        return Some(ArgDisplay)
    system
        var out: ?DeflogArgType = None
        let dot = find_text(token, "..")
        if dot > 0 and span_is_digits(token, 0, dot) and span_is_digits(token, dot + 2, n)
            let start = digits_to_int(token, 0, dot)
            let end = digits_to_int(token, dot + 2, n)
            if start < end and end <= 128
                out = Some(ArgBitField(start, end))
        match array_length(token, "[u8;")
            Some(len) =>
                out = Some(ArgU8Array(len))
            None      =>
                if let Some(len) = array_length(token, "[?;")
                    out = Some(ArgFormatArray(len))
        return out

// hint_prefix writes the `#` and the `0<width>` a display hint may
// carry in front of the hint's name.  The alternate marker comes first
// and the width second, which is the order a parser reads.
fn hint_prefix(alternate: Bool, zero_pad: Int, name: Str) -> Str
    system
        var out = ""
        if alternate
            out = out + "#"
        if zero_pad > 0
            out = out + "0" + str.from_int(zero_pad)
        return out + name

// iso_token is the `iso8601…` spelling, one per precision.  The suffix
// is the precision, so seconds and nanoseconds cannot share a token.
fn iso_token(precision: DeflogPrecision) -> Str
    match precision
        PrecSeconds      => "iso8601s"
        PrecMilliseconds => "iso8601ms"
        PrecMicroseconds => "iso8601us"
        PrecNanoseconds  => "iso8601ns"

// bitflags_token rebuilds the three `@`-separated parts, which is how a
// bit set tells a decoder which declaration to look up in the symbol
// table it already has.
fn bitflags_token(name: Str, package: Str, disambiguator: Str) -> Str
    system
        return "__internal_bitflags_" + name + "@" + package + "@" + disambiguator

// hint_token is the display hint as it is written after the `:`.
pub fn hint_token(h: DeflogHint) -> Str
    match h
        HintNone(zero_pad)                         => hint_prefix(false, zero_pad, "")
        HintBinary(alternate, zero_pad)            => hint_prefix(alternate, zero_pad, "b")
        HintHex(alternate, uppercase, zero_pad)    =>
            if uppercase
                hint_prefix(alternate, zero_pad, "X")
            else
                hint_prefix(alternate, zero_pad, "x")
        HintOctal(alternate, zero_pad)             => hint_prefix(alternate, zero_pad, "o")
        HintAscii                                  => "a"
        HintDebug                                  => "?"
        HintSeqDebug                               => "?"
        HintMicroseconds                           => "us"
        HintMilliseconds                           => "ms"
        HintSeconds                                => "s"
        HintIso8601(precision)                     => iso_token(precision)
        HintBitflags(name, package, disambiguator) => bitflags_token(name, package, disambiguator)
        HintUnknown(text)                          => text

// one_byte is the byte at `i` of `s`, as a one-byte string.  The index
// sugar written inline in an operand position strands the byte it
// makes, and the answer of a call is released, so every string index in
// the package goes through this one function.
fn one_byte(s: Str, i: Int) -> Str
    s[i]

// substr copies a byte range out as a string of its own.  A hint name
// is a few dozen bytes, and the embedded surface has no substring
// operation to copy it with, so one byte at a time is the whole of it.
fn substr(s: Str, lo: Int, hi: Int) -> Str
    system
        var out = ""
        for i in lo..hi
            out = out + one_byte(s, i)
        return out

// find_byte is the first index in `[lo, hi)` holding a given byte, or
// `-1` when the range holds none.  The upper bound matters: a `:` after
// a hole's closing brace does not belong to the hole.
fn find_byte(s: Str, lo: Int, hi: Int, b: Int) -> Int
    var found = -1
    for i in lo..hi
        if found < 0 and str.byte_at_or(s, i, 0) == b
            found = i
    found

// bitflags_hint reads the three `@`-separated parts of the
// `__internal_bitflags_…` hint.  A fourth part is not a hint this
// package has a shape for, so it is left to the forward-compatible
// mode to keep whole.
fn bitflags_hint(token: Str, lo: Int, hi: Int) -> ?DeflogHint
    let head = "__internal_bitflags_"
    let start = lo + str.len(head)
    if start > hi or not slice_eq(token, lo, start, head)
        return None
    let first = find_byte(token, start, hi, 64)
    if first < 0
        return None
    let second = find_byte(token, first + 1, hi, 64)
    if second < 0
        return None
    if find_byte(token, second + 1, hi, 64) >= 0
        return None
    system
        return Some(HintBitflags(substr(token, start, first),
            substr(token, first + 1, second),
            substr(token, second + 1, hi)))

// hint_of_token is the display hint a `:` suffix spells, or `None`.
pub fn hint_of_token(token: Str) -> ?DeflogHint
    let n = str.len(token)
    var i = 0
    var alternate = false
    if i < n and str.byte_at_or(token, i, 0) == 35
        alternate = true
        i = i + 1
    let after_digits = digit_end(token, i)
    var zero_pad = 0
    if after_digits > i
        zero_pad = digits_to_int(token, i, after_digits)
        i = after_digits
    system
        if slice_eq(token, i, n, "")
            return Some(HintNone(zero_pad))
        if slice_eq(token, i, n, "b")
            return Some(HintBinary(alternate, zero_pad))
        if slice_eq(token, i, n, "x")
            return Some(HintHex(alternate, false, zero_pad))
        if slice_eq(token, i, n, "X")
            return Some(HintHex(alternate, true, zero_pad))
        if slice_eq(token, i, n, "o")
            return Some(HintOctal(alternate, zero_pad))
        if slice_eq(token, i, n, "a")
            return Some(HintAscii)
        if slice_eq(token, i, n, "?")
            return Some(HintDebug)
        if slice_eq(token, i, n, "us")
            return Some(HintMicroseconds)
        if slice_eq(token, i, n, "ms")
            return Some(HintMilliseconds)
        if slice_eq(token, i, n, "s")
            return Some(HintSeconds)
        if slice_eq(token, i, n, "iso8601s")
            return Some(HintIso8601(PrecSeconds))
        if slice_eq(token, i, n, "iso8601ms")
            return Some(HintIso8601(PrecMilliseconds))
        if slice_eq(token, i, n, "iso8601us")
            return Some(HintIso8601(PrecMicroseconds))
        if slice_eq(token, i, n, "iso8601ns")
            return Some(HintIso8601(PrecNanoseconds))
        return bitflags_hint(token, i, n)

// arg_width is how many bytes the type occupies on the wire, or `None`
// when it is not a fixed number.
//
// THE FUNCTION A DECODER READS ARGUMENTS WITH.  `Some(4)` for
// `ArgU32`; `None` for `ArgUsize` (a varint), `ArgStr` (a length and
// then bytes), and every `ArgFormat` shape (a nested walk).  A
// bitfield is `Some(0)` and NOT `None`: it consumes nothing, because
// its bits came out of an argument that was sent separately.
pub fn arg_width(t: DeflogArgType) -> ?Int
    match t
        ArgBool                 => Some(1)
        ArgU8                   => Some(1)
        ArgU16                  => Some(2)
        ArgU24                  => Some(3)
        ArgU32                  => Some(4)
        ArgU64                  => Some(8)
        ArgU128                 => Some(16)
        ArgI8                   => Some(1)
        ArgI16                  => Some(2)
        ArgI32                  => Some(4)
        ArgI64                  => Some(8)
        ArgI128                 => Some(16)
        ArgF32                  => Some(4)
        ArgF64                  => Some(8)
        ArgChar                 => Some(4)
        ArgU8Array(len)         => Some(len)
        ArgBitField(start, end) => Some(0)
        _                       => None

// is_bitfield says whether the type reads bits out of another
// argument rather than bytes off the wire.
pub fn is_bitfield(t: DeflogArgType) -> Bool
    match t
        ArgBitField(start, end) => true
        _                       => false

// is_nested says whether the type carries another formatted value
// inside it — the four `ArgFormat…` arms and `ArgDebug`.
//
// The predicate a decoder branches on to decide whether it needs the
// symbol table again while reading a single argument.
pub fn is_nested(t: DeflogArgType) -> Bool
    match t
        ArgFormat           => true
        ArgFormatSlice      => true
        ArgFormatArray(len) => true
        ArgFormatSequence   => true
        ArgDebug            => true
        _                   => false

// is_signed says whether the type's bytes are read as two's complement.
pub fn is_signed(t: DeflogArgType) -> Bool
    match t
        ArgI8    => true
        ArgI16   => true
        ArgI32   => true
        ArgI64   => true
        ArgI128  => true
        ArgIsize => true
        _        => false
